<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_lab_request_log_tree" model="ir.ui.view">
            <field name="name">lab.request.log.tree</field>
            <field name="model">lab.request.log</field>
            <field name="arch" type="xml">
                <list string="请求记账" create="false" edit="false" delete="false">
                    <field name="request_key"/>
                    <field name="method"/>
                    <field name="state"/>
                    <field name="create_date"/>
                    <field name="user_id"/>
                    <field name="payload_fingerprint"/>
                    <field name="error_code"/>
                    <field name="error_message"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_lab_request_log_form" model="ir.ui.view">
            <field name="name">lab.request.log.form</field>
            <field name="model">lab.request.log</field>
            <field name="arch" type="xml">
                <form string="请求记账" create="false" edit="false" delete="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="request_key"/>
                                <field name="method"/>
                                <field name="state"/>
                                <field name="user_id"/>
                            </group>
                            <group>
                                <field name="create_date"/>
                                <field name="payload_fingerprint"/>
                                <field name="error_code"/>
                                <field name="error_message"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="请求内容" name="payload">
                                <field name="payload_json" readonly="1"/>
                            </page>
                            <page string="返回内容" name="response">
                                <field name="response_json" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_lab_request_log_search" model="ir.ui.view">
            <field name="name">lab.request.log.search</field>
            <field name="model">lab.request.log</field>
            <field name="arch" type="xml">
                <search string="搜索请求记账">
                    <field name="request_key"/>
                    <field name="method"/>
                    <field name="user_id"/>
                    <separator/>
                    <filter name="state_succeeded" string="已记账"
                            domain="[('state', '=', 'succeeded')]"/>
                    <filter name="state_failed" string="失败"
                            domain="[('state', '=', 'failed')]"/>
                    <filter name="state_pending" string="进行中"
                            domain="[('state', '=', 'pending')]"/>
                    <filter name="group_method" string="接口"
                            context="{'group_by': 'method'}"/>
                    <filter name="group_state" string="状态"
                            context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>

        <record id="action_lab_request_log" model="ir.actions.act_window">
            <field name="name">请求记账（幂等）</field>
            <field name="res_model">lab.request.log</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_lab_request_log_search"/>
        </record>

    </data>
</odoo>
