<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lab_location_list" model="ir.ui.view">
        <field name="name">lab.stock.location.list</field>
        <field name="model">stock.location</field>
        <field name="arch" type="xml">
            <list string="库位">
                <field name="name"/>
                <field name="complete_name"/>
                <field name="usage"/>
                <field name="lab_location_type"/>
                <field name="lab_color"/>
                <field name="lab_sort"/>
            </list>
        </field>
    </record>
    <record id="view_lab_location_form" model="ir.ui.view">
        <field name="name">lab.stock.location.form</field>
        <field name="model">stock.location</field>
        <field name="arch" type="xml">
            <form string="库位">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="如 R01-3"/>
                            <field name="location_id" placeholder="父级库位"/>
                        </group>
                        <group>
                            <field name="usage"/>
                            <field name="lab_location_type"/>
                            <field name="lab_color" placeholder="#FF5252"/>
                            <field name="lab_sort"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_lab_location" model="ir.actions.act_window">
        <field name="name">库位管理</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_lab_location_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_lab_location_form')})]"/>
        <field name="context">{'default_usage': 'internal'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">创建第一个库位</p>
            <p>结构：实验室(view) → 类型组(view) → 具体库位(internal)。类型组按 lab_location_type 分类。</p>
        </field>
    </record>
</odoo>
