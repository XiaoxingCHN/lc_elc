<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lab_mapping_list" model="ir.ui.view">
        <field name="name">lab.inbound.category.mapping.list</field>
        <field name="model">lab.inbound.category.mapping</field>
        <field name="arch" type="xml">
            <list string="类别→库位映射" editable="bottom">
                <field name="category"/>
                <field name="location_id"/>
                <field name="note"/>
            </list>
        </field>
    </record>
    <record id="view_lab_mapping_form" model="ir.ui.view">
        <field name="name">lab.inbound.category.mapping.form</field>
        <field name="model">lab.inbound.category.mapping</field>
        <field name="arch" type="xml">
            <form string="类别→库位映射">
                <sheet>
                    <group>
                        <field name="category" placeholder="如 电阻 / LDO / 连接器"/>
                        <field name="location_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_lab_mapping" model="ir.actions.act_window">
        <field name="name">类别→库位映射</field>
        <field name="res_model">lab.inbound.category.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">创建第一条映射</p>
            <p>扫码入库时按器件类别自动带出默认库位，替代源系统的 InboundCategoryLocationMapping。</p>
        </field>
    </record>
</odoo>
