<?xml version="1.0" encoding="utf-8"?>
<!--
  注意（Odoo 19）：xmlid `stock.module_category_inventory` 已不存在，
  因此这里不再设置 category_id（权限组会显示在“未分类”下，功能不受影响）。
  若确实需要归类，先执行：
    SELECT module,name FROM ir_model_data WHERE model='ir.module.category' AND name LIKE '%inventor%';
  再把查到的 xmlid 填回 category_id ref="..."。
-->
<odoo>
    <record id="group_lab_admin" model="res.groups">
        <field name="name">实验室库存管理员</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="comment">管理元器件档案、库位、类别映射、BOM 分配；可使用迁移与补全脚本的服务账号。</field>
    </record>
    <record id="group_lab_user" model="res.groups">
        <field name="name">实验室库存操作员</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">日常出入库操作；只读查看类别映射。</field>
    </record>
</odoo>
