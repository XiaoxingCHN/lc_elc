<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         业务页面公共外壳（P3 / T0）
         ==================================================================
         三路 UI 子任务只写自己的 views/workflow_<domain>.xml，并统一用
         t-call="lab_team_web.workflow_page"；本文件提供：

           workflow_page             有页头的标准页面（推荐）
           workflow_body             无页头（页头自己画）
           workflow_status           状态区片段（可单独 t-call）
           workflow_placeholder      正式界面未落地时的说明页
           workflow_placeholder_body 占位正文
           workflow_page_tail        资源尾巴（domain CSS 由 layout 输出，
                                     page JS 在正文后输出）

         为什么不用"多层 t-call 再转交 t-out=0"：QWeb 的 "0" 指向**当前**
         t-call 的正文，嵌套转交容易变成自引用。这里宁可保留两段直白的
         layout 调用，也不引入这种隐式递归风险。

         约束：
         * 全部继承 lab_team_web.layout，不碰 website.layout / web.layout；
         * 只有外链 <script src>，没有内联脚本/事件属性（CSP script-src 'self'）；
         * page JS 只有在文件存在（内容哈希 != '0'）时才输出标签，避免子任务
           还没创建文件时浏览器打 404；domain CSS 同样条件，在 layout 的
           <head> 里输出。
         ================================================================== -->

    <!-- 状态区片段：core 的 LC.status 通过 [data-lc-status] 渲染六态 -->
    <template id="workflow_status" name="LC Workflow Status">
        <div class="lc-status-region" data-lc-status-region="">
            <div class="lc-status" data-lc-status="" hidden="hidden"
                 role="status" aria-live="polite"></div>
        </div>
    </template>

    <!-- 资源尾巴：业务页面 JS（defer，加载顺序在 core/team.js 之后） -->
    <template id="workflow_page_tail" name="LC Workflow Page Tail">
        <t t-if="lc_page_id and lc_page_js_v and lc_page_js_v != '0'">
            <script defer="defer"
                    t-attf-src="/lab_team_web/static/src/js/pages/#{lc_page_id}.js?v=#{lc_page_js_v}"></script>
        </t>
    </template>

    <!-- 标准页面：页头 + 正文 -->
    <template id="workflow_page" name="LC Workflow Page">
        <t t-call="lab_team_web.layout">
            <div class="lc-workflow" id="workflow-root"
                 t-att-data-workflow-page="lc_page_id or ''"
                 t-att-data-domain="lc_domain or ''"
                 t-att-data-page-title="lc_page_title or ''"
                 t-att-data-base="lc_base or ''">
                <t t-call="lab_team_web.workflow_status"/>
                <header class="lc-page-head">
                    <h1 class="lc-page-title" t-esc="lc_page_title or lc_page_id"/>
                    <p class="lc-page-desc" t-if="lc_page_desc" t-esc="lc_page_desc"/>
                </header>
                <div class="lc-workflow-body">
                    <t t-out="0"/>
                </div>
            </div>
            <t t-call="lab_team_web.workflow_page_tail"/>
        </t>
    </template>

    <!-- 无页头页面（页头由模板自己画） -->
    <template id="workflow_body" name="LC Workflow Body">
        <t t-call="lab_team_web.layout">
            <div class="lc-workflow" id="workflow-root"
                 t-att-data-workflow-page="lc_page_id or ''"
                 t-att-data-domain="lc_domain or ''"
                 t-att-data-page-title="lc_page_title or ''"
                 t-att-data-base="lc_base or ''">
                <t t-call="lab_team_web.workflow_status"/>
                <div class="lc-workflow-body">
                    <t t-out="0"/>
                </div>
            </div>
            <t t-call="lab_team_web.workflow_page_tail"/>
        </t>
    </template>

    <!-- 占位正文：路由已接入、界面待实现时的诚实状态（不是空白页） -->
    <template id="workflow_placeholder_body" name="LC Workflow Placeholder Body">
        <section class="lc-panel">
            <div class="lc-panel-head">
                <h2 class="lc-section-title">界面尚未接入</h2>
            </div>
            <div class="lc-panel-body">
                <p class="lc-lead">
                    该页面的地址、导航与会话权限已经就绪；界面由
                    <b t-esc="lc_domain or '待分配'"/> 子任务实现。
                </p>
                <p class="lc-note">
                    页面标识：<span class="lc-mono" t-esc="lc_page_id or '—'"/>
                </p>
                <p class="lc-hint">
                    数据接口可用；此页不带任何业务表单，不会写入库存。
                </p>
                <div class="lc-actions">
                    <a class="lc-btn lc-btn-primary" t-att-href="lc_entry_urls['lab']">返回仓库</a>
                    <a class="lc-btn lc-btn-outline" t-att-href="lc_entry_urls['scan']">扫码</a>
                </div>
            </div>
        </section>
    </template>

    <!-- 完整占位页 -->
    <template id="workflow_placeholder" name="LC Workflow Placeholder">
        <t t-call="lab_team_web.workflow_page">
            <t t-call="lab_team_web.workflow_placeholder_body"/>
        </t>
    </template>

</odoo>
