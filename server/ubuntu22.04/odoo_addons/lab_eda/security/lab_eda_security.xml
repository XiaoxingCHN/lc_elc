<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
          普通用户只能看到自己的 token（插件里显示「这个密钥是谁的」）；
          库存管理员看全部，因为要替任何人发放和吊销。
          两条规则取并集。
        -->
        <record id="rule_lab_eda_token_user" model="ir.rule">
            <field name="name">EDA 密钥：仅本人可见</field>
            <field name="model_id" ref="model_lab_eda_token"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_lab_eda_token_manager" model="ir.rule">
            <field name="name">EDA 密钥：库存管理员全部可见</field>
            <field name="model_id" ref="model_lab_eda_token"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('lab_workflow.group_lab_manager'))]"/>
        </record>

    </data>
</odoo>
