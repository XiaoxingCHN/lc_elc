<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer policy for the lab inventory client.

  The "记住登录" password is encrypted by flutter_secure_storage with a key that
  is generated inside the Android Keystore of THIS device and cannot leave it.
  If Android ever restored the ciphertext onto another device (Google Drive auto
  backup, or an API 31+ device-to-device transfer) the app would be holding
  bytes it can never decrypt - the classic
  "java.security.InvalidKeyException: Failed to unwrap key" failure - and the
  operator would silently lose the remembered login.

  `android:allowBackup="false"` already switches cloud backup off; these rules
  additionally exclude the app's preferences and files from a device transfer on
  API 31+, so nothing secret or undecryptable is moved between devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
